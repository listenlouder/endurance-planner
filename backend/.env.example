# Django secret key — generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to True only in development, never in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (e.g. localhost,127.0.0.1,myapp.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# The single hostname users should end up on. Session and CSRF cookies are
# host-only, so serving the site at both wearechecking.gg and
# www.wearechecking.gg means logging in on one does not carry to the other.
# When set, requests on any other host are 301'd here. Leave blank in local dev.
#
# ALLOWED_HOSTS must list CANONICAL_HOST *and every host you want redirected*.
# Django validates the Host header before the redirect runs, so a host missing
# from ALLOWED_HOSTS gets a bare 400 instead of a 301 — leaving www broken,
# which is the case this setting exists to fix. For example:
#   ALLOWED_HOSTS=wearechecking.gg,www.wearechecking.gg
#   CANONICAL_HOST=wearechecking.gg
CANONICAL_HOST=

# Domain recorded on the django.contrib.sites row. The Discord OAuth callback
# follows the request host, so this does not steer login; it is used for
# absolute URLs built without a request, and pinning it keeps the site domain
# from silently changing when ALLOWED_HOSTS is reordered.
# Defaults to CANONICAL_HOST, then to the first ALLOWED_HOSTS entry.
SITE_DOMAIN=

# MariaDB / MySQL database name
DB_NAME=endurance_planner

# Database user with full privileges on DB_NAME
DB_USER=endurance_user

# Password for DB_USER
DB_PASSWORD=

# Database host (usually localhost for local dev)
DB_HOST=localhost

# Database port (MariaDB/MySQL default is 3306)
DB_PORT=3306

# Static files root — used by collectstatic in production
# STATIC_ROOT is set automatically in settings.py (BASE_DIR/staticfiles)

# Password to access the feedback viewer at /feedback/view/
FEEDBACK_PASSWORD=choose-a-strong-password

# Discord OAuth — register app at discord.com/developers
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Root log level. INFO gives one line per request; DEBUG is very loud and is
# only worth it while chasing something specific.
LOG_LEVEL=INFO

# stdout format: json or console. Defaults to console when DJANGO_DEBUG is
# True and json otherwise. Railway's log browser can only search text, so
# discrete JSON keys are what make status, route and request_id filterable
# there — leave this at json in production.
LOG_FORMAT=

# Sentry DSN from sentry.io. Leave blank to disable error reporting entirely;
# nothing is initialised and no network calls are made. Set it and unhandled
# exceptions arrive with a stack trace, grouped, with an alert.
#
# Event admin keys are stripped from URLs, breadcrumbs and captured stack
# frames before anything is sent — see config.logging.scrub_event.
SENTRY_DSN=

# Label separating environments in the Sentry UI.
SENTRY_ENVIRONMENT=production

# Fraction of requests traced for performance (0 to 1). Off by default; this
# is an error tracker, not an APM, and tracing spends the free-tier quota
# fast.
SENTRY_TRACES_SAMPLE_RATE=0

# Kill switch for ActivityLog database writes. Set to False to stop recording
# usage without a deploy; the structured log stream carries on regardless.
ACTIVITY_LOG_ENABLED=True

# How long usage rows are kept. The prune_activity management command deletes
# anything older; it has to be run on a schedule for this to have any effect.
ACTIVITY_RETENTION_DAYS=90
